# Required for phone case lifestyle mockup image editing.
# Local development: copy this file to .env, set the key there, and restart the server.
# Keep your local .env private and never commit it.
POLLINATIONS_API_KEY="YOUR_POLLINATIONS_API_KEY"

# Used by legacy artwork-generation endpoints only; not used for lifestyle mockups.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: Google OAuth web client ID for the Etsy Listing & Sheets export panel.
# Enable Google Drive API and Google Sheets API, then allow your app's origin in OAuth settings.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID"
